<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Maven POM (Project Object Model) — основной файл конфигурации проекта.
        Определяет структуру, зависимости, плагины и настройки сборки.
    -->
    <modelVersion>4.0.0</modelVersion> <!-- Версия POM-модели. Используем всегда 4.0.0. для совместимости-->

    <!-- === Координаты проекта (GAV — Group, Artifact, Version) === -->
    <!-- Уникально идентифицируют проект в Maven-репозитории -->
    <groupId>com.shop</groupId> <!-- Обратный домен организации или название компании/подразделения -->
    <artifactId>webShopProject</artifactId> <!-- Уникальное имя артефакта (JAR/WAR файла, который будет собран) -->
    <version>1.0-SNAPSHOT</version>
    <!--
        Тип упаковки:
        - pom    — родительский проект (только для управления модулями/зависимостями)
        - jar    — обычная Java-библиотека (стандарт для микросервисов)
        - war    — для развёртывания на сервере приложений (Tomcat, Jetty)
        - maven-plugin — плагин для Maven
    -->
    <packaging>pom</packaging>

    <!-- Вынос версии и настройки в переменные для переиспользования -->
    <properties>
        <java.version>25</java.version> <!-- Версия JDK для компиляции и запуска -->
        <spring-boot.version>4.0.6</spring-boot.version> <!-- Версия Spring Boot BOM (Bill of Materials). Определяет совместимые версии всех Spring-модулей и их зависимостей. -->
        <maven.compiler.source>${java.version}</maven.compiler.source> <!-- Версия исходного кода Java, которую поддерживает компилятор -->
        <maven.compiler.target>${java.version}</maven.compiler.target> <!-- Версия Java, в которую будет скомпилирован байткод -->
        <maven.compiler-plugin.version>3.15.0</maven.compiler-plugin.version> <!-- Версия плагина Maven -->
        <!--
            Версия Lombok, используемая процессором аннотаций в maven-compiler-plugin.
            Соответствует версии, управляемой Spring Boot BOM (org.projectlombok:lombok),
            чтобы избежать расхождения между зависимостью и процессором аннотаций.
        -->
        <lombok.version>1.18.46</lombok.version>
        <jjwt.version>0.12.6</jjwt.version> <!-- Версия библиотек JJWT; управляется из родительского POM (см. dependencyManagement) -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Определение версий зависимостей для всех дочерних модулей.
        Сами зависимости не подключаются — только указываются версии.
        В дочерних модулях пишем <dependency> без <version> и подключаем конкретные зависимости.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope> <!--import — используется только с type=pom. Позволяет импортировать зависимости из BOM в текущий проект. -->
            </dependency>

            <!--
                Библиотеки JJWT для работы с JWT. Не входят в Spring Boot BOM,
                поэтому их версия централизованно задаётся здесь — в детских модулях
                версия не указывается.
            -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Общая конфигурация плагинов сборки для всех дочерних модулей.
        pluginManagement — это аналог dependencyManagement, но для плагинов:
        здесь ОПРЕДЕЛЯЕТСЯ версия и настройки плагинов, а сами плагины в сборку
        не подключаются. В дочернем модуле достаточно объявить <plugin>
        (без <version> и без <executions>) — Maven сам подтянет конфигурацию отсюда.

        Зачем это нужно: у каждого сервиса (auth, product, а в будущем и рекомендаций)
        одна и та же конфигурация сборки Spring Boot. Храня её в одном месте,
        мы избавляемся от дублирования в каждом pom.xml и облегчаем её изменение.
    -->
    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Плагин сборки Spring Boot.
                    Упаковывает приложение в executable JAR (fat JAR со всеми зависимостями)
                    и позволяет запускать через java -jar или mvn spring-boot:run.
                    Привязываем goal repackage к фазе package: в отличие от
                    spring-boot-starter-parent, наш собственный родитель (webShopProject)
                    сам этого не делает, поэтому связываем вручную. Без этой привязки
                    получился бы "тонкий" JAR, который нельзя запустить через java -jar.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                    maven-compiler-plugin — официальный плагин Maven для компиляции Java-кода.
                    Указываем версию Java (${java.version}) и Lombok как процессор аннотаций,
                    чтобы геттеры, сеттеры, конструкторы и билдеры генерировались при компиляции.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths> <!-- Указываем Lombok как процессор аннотаций -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- Список модулей, которые входят в сборку -->
    <modules>
        <module>backend/auth-service</module>
        <module>backend/product-service</module>
    </modules>
</project>